@model Orizon.Distribuidora.Web.Areas.Admin.Models.Commercial.QuoteDetailsViewModel
@{Layout=null;var q=Model.Quote;}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Orçamento ORC-@q.Number.ToString("000000")</title><link rel="stylesheet" href="~/css/commercial-print.css" asp-append-version="true"/></head><body><main class="print-document">
<header><div><h1>@(Model.Company?.TradeName??"Empresa")</h1><p>@Model.Company?.LegalName · CNPJ/CPF @Model.Company?.Document</p></div><div><strong>ORÇAMENTO</strong><span>ORC-@q.Number.ToString("000000")</span></div></header>
<div class="warning">DOCUMENTO NÃO FISCAL — NÃO SUBSTITUI NOTA FISCAL</div><section class="meta"><p><strong>Cliente:</strong> @q.CustomerName</p><p><strong>Documento:</strong> @(q.CustomerDocument??"Não informado")</p><p><strong>Emissão:</strong> @q.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><p><strong>Validade:</strong> @q.ValidUntil.ToString("dd/MM/yyyy")</p></section>
<table><thead><tr><th>Código</th><th>Produto</th><th>Un.</th><th>Quantidade</th><th>Preço</th><th>Desconto</th><th>Total</th></tr></thead><tbody>@foreach(var x in q.Items){<tr><td>@x.ProductCode</td><td>@x.Description</td><td>@x.Unit</td><td>@x.Quantity.ToString("N3")</td><td>@x.UnitPrice.ToString("C")</td><td>@x.Discount.ToString("C")</td><td>@x.Total.ToString("C")</td></tr>}</tbody></table>
<section class="totals"><p>Subtotal <strong>@q.Subtotal.ToString("C")</strong></p><p>Desconto <strong>@q.Discount.ToString("C")</strong></p><p>Frete <strong>@q.Freight.ToString("C")</strong></p><p class="grand">Total <strong>@q.Total.ToString("C")</strong></p></section>@if(!string.IsNullOrWhiteSpace(q.Notes)){<section><h2>Observações</h2><p>@q.Notes</p></section>}<footer>Referência interna: @q.Id · Responsável: sistema Orizon Distribuidora</footer></main><button class="print-button" onclick="window.print()">Imprimir / Salvar como PDF</button></body></html>
