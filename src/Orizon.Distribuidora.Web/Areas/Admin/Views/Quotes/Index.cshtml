@model Orizon.Distribuidora.Web.Areas.Admin.Models.Commercial.QuoteIndexViewModel
@using Orizon.Distribuidora.Domain.Enums
@{ ViewData["Title"]="Orçamentos"; var f=Model.Filter; }
@section Styles { <link rel="stylesheet" href="~/css/commercial-premium.css" asp-append-version="true" /> }
<section class="commercial-workspace">
 <header class="commercial-header"><div><h1>Orçamentos</h1><p>Propostas comerciais não fiscais e conversão em vendas.</p></div><a class="commercial-button primary" asp-action="New">Novo orçamento</a></header>
 @if(TempData["Success"] is string ok){<div class="commercial-alert success" role="status">@ok</div>} @if(TempData["Error"] is string err){<div class="commercial-alert error" role="alert">@err</div>}
 <div class="commercial-kpis" aria-label="Resumo"><div><span>Em aberto</span><strong>@Model.Summary.Open</strong></div><div><span>Aguardando resposta</span><strong>@Model.Summary.AwaitingResponse</strong></div><div><span>Aprovados</span><strong>@Model.Summary.Approved</strong></div><div><span>Vencidos</span><strong>@Model.Summary.Expired</strong></div><div><span>Convertidos</span><strong>@Model.Summary.Converted</strong></div><div><span>Valor em aberto</span><strong>@Model.Summary.OpenValue.ToString("C")</strong><small>@Model.Summary.ConversionRate.ToString("N1")% conversão</small></div></div>
 <form method="get" class="commercial-filters"><input type="search" name="Search" value="@f.Search" placeholder="Número ou cliente" aria-label="Pesquisar"/><select name="CustomerId" aria-label="Cliente"><option value="">Todos os clientes</option>@foreach(var x in Model.Options.Customers){<option value="@x.Id" selected="@(f.CustomerId==x.Id)">@x.Label</option>}</select><select name="Status" aria-label="Situação"><option value="">Todas as situações</option>@foreach(var x in Enum.GetValues<QuoteStatus>()){<option value="@x" selected="@(f.Status==x)">@x</option>}</select><input type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")" aria-label="Emissão inicial"/><input type="date" name="To" value="@f.To?.ToString("yyyy-MM-dd")" aria-label="Emissão final"/><select name="SortBy" aria-label="Ordenar"><option value="issued">Emissão</option><option value="number">Número</option><option value="customer">Cliente</option><option value="total">Total</option></select><button class="commercial-button primary">Filtrar</button><a class="commercial-button" asp-action="Index">Limpar</a></form>
 <div class="commercial-card"><div class="commercial-card-head"><h2>Orçamentos</h2><span>@Model.Page.TotalCount registro(s)</span></div><div class="commercial-table-scroll" tabindex="0"><table><thead><tr><th>Número</th><th>Cliente</th><th>Emissão</th><th>Validade</th><th>Situação</th><th class="num">Total</th><th>Venda</th><th>Ações</th></tr></thead><tbody>
 @if(Model.Page.Items.Count==0){<tr><td colspan="8" class="commercial-empty"><strong>Nenhum orçamento encontrado</strong><span>Crie um orçamento ou ajuste os filtros.</span></td></tr>}else foreach(var x in Model.Page.Items){<tr><td><strong>ORC-@x.Number.ToString("000000")</strong></td><td>@x.CustomerName</td><td>@x.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@x.ValidUntil.ToString("dd/MM/yyyy")</td><td><span class="commercial-status">@x.Status</span></td><td class="num">@x.Total.ToString("C")</td><td>@(x.SaleId.HasValue?"Vinculada":"—")</td><td><a asp-action="Details" asp-route-id="@x.Id">Abrir</a></td></tr>}
 </tbody></table></div><footer class="commercial-pagination"><span>Página @Model.Page.Page de @Model.TotalPages</span><nav>@if(Model.Page.Page>1){<a class="commercial-button" asp-route-Page="@(Model.Page.Page-1)" asp-route-Search="@f.Search" asp-route-Status="@f.Status">Anterior</a>} @if(Model.Page.Page<Model.TotalPages){<a class="commercial-button" asp-route-Page="@(Model.Page.Page+1)" asp-route-Search="@f.Search" asp-route-Status="@f.Status">Próxima</a>}</nav></footer></div>
</section>
