@model Orizon.Distribuidora.Web.Areas.Admin.Models.Commercial.QuoteDetailsViewModel
@using Orizon.Distribuidora.Domain.Enums
@{ViewData["Title"]=$"Orçamento ORC-{Model.Quote.Number:000000}";var q=Model.Quote;}
@section Styles { <link rel="stylesheet" href="~/css/commercial-premium.css" asp-append-version="true" /> }
<section class="commercial-workspace"><header class="commercial-header"><div><h1>ORC-@q.Number.ToString("000000")</h1><p>@q.CustomerName · @q.Status</p></div><div class="commercial-actions"><a class="commercial-button" asp-action="Print" asp-route-id="@q.Id" target="_blank">Imprimir / PDF</a>@if(q.Status==QuoteStatus.Draft){<a class="commercial-button" asp-action="Edit" asp-route-id="@q.Id">Editar</a>}</div></header>
@if(TempData["Success"] is string ok){<div class="commercial-alert success">@ok</div>}@if(TempData["Error"] is string err){<div class="commercial-alert error">@err</div>}
<div class="non-fiscal-banner">DOCUMENTO NÃO FISCAL — NÃO SUBSTITUI NOTA FISCAL</div>
<div class="detail-grid"><section class="commercial-card detail-main"><h2>Itens</h2><div class="commercial-table-scroll"><table><thead><tr><th>Código</th><th>Descrição</th><th>Un.</th><th class="num">Qtd.</th><th class="num">Preço</th><th class="num">Desconto</th><th class="num">Total</th></tr></thead><tbody>@foreach(var x in q.Items){<tr><td>@x.ProductCode</td><td>@x.Description</td><td>@x.Unit</td><td class="num">@x.Quantity.ToString("N3")</td><td class="num">@x.UnitPrice.ToString("C")</td><td class="num">@x.Discount.ToString("C")</td><td class="num">@x.Total.ToString("C")</td></tr>}</tbody></table></div></section><aside class="commercial-card detail-summary"><h2>Resumo</h2><dl><dt>Emissão</dt><dd>@q.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd><dt>Validade</dt><dd>@q.ValidUntil.ToString("dd/MM/yyyy")</dd><dt>Subtotal</dt><dd>@q.Subtotal.ToString("C")</dd><dt>Desconto</dt><dd>@q.Discount.ToString("C")</dd><dt>Frete</dt><dd>@q.Freight.ToString("C")</dd><dt>Total</dt><dd><strong>@q.Total.ToString("C")</strong></dd></dl></aside></div>
<div class="commercial-actions action-bar">@if(q.Status==QuoteStatus.Draft){<form asp-action="Send" asp-route-id="@q.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button primary">Marcar enviado</button></form>}@if(q.Status==QuoteStatus.Sent){<form asp-action="Approve" asp-route-id="@q.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button primary">Aprovar</button></form><form asp-action="Reject" asp-route-id="@q.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button">Recusar</button></form>}@if(q.Status==QuoteStatus.Approved){<form asp-action="Convert" asp-route-id="@q.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button primary">Converter em venda</button></form>}@if(q.Status is not (QuoteStatus.Converted or QuoteStatus.Cancelled)){<form asp-action="Cancel" asp-route-id="@q.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button danger">Cancelar</button></form>}@if(q.SaleId.HasValue){<a class="commercial-button primary" asp-controller="Sales" asp-action="Details" asp-route-id="@q.SaleId">Abrir venda</a>}</div></section>
