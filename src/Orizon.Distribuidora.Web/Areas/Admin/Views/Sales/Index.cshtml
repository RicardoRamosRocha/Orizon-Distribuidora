@model Orizon.Distribuidora.Web.Areas.Admin.Models.Commercial.SaleIndexViewModel
@using Orizon.Distribuidora.Domain.Enums
@{ ViewData["Title"]="Vendas"; var f=Model.Filter; }
@section Styles { <link rel="stylesheet" href="~/css/commercial-premium.css" asp-append-version="true" /> }
<section class="commercial-workspace"><header class="commercial-header"><div><h1>Vendas</h1><p>Acompanhamento comercial, pagamento e estado fiscal independente.</p></div></header>
@if(TempData["Success"] is string ok){<div class="commercial-alert success">@ok</div>} @if(TempData["Error"] is string err){<div class="commercial-alert error">@err</div>}
<div class="commercial-kpis"><div><span>Vendas</span><strong>@Model.Summary.Total</strong></div><div><span>Confirmadas</span><strong>@Model.Summary.Confirmed</strong></div><div><span>Aguardando pagamento</span><strong>@Model.Summary.AwaitingPayment</strong></div><div><span>Concluídas</span><strong>@Model.Summary.Completed</strong></div><div><span>Canceladas</span><strong>@Model.Summary.Cancelled</strong></div><div><span>Valor ativo</span><strong>@Model.Summary.TotalValue.ToString("C")</strong></div></div>
<form method="get" class="commercial-filters"><input type="search" name="Search" value="@f.Search" placeholder="Número ou cliente"/><select name="CustomerId"><option value="">Todos os clientes</option>@foreach(var x in Model.Options.Customers){<option value="@x.Id" selected="@(f.CustomerId==x.Id)">@x.Label</option>}</select><select name="Status"><option value="">Estado comercial</option>@foreach(var x in Enum.GetValues<SaleStatus>()){<option value="@x" selected="@(f.Status==x)">@x</option>}</select><select name="PaymentStatus"><option value="">Pagamento</option>@foreach(var x in Enum.GetValues<PaymentStatus>()){<option value="@x" selected="@(f.PaymentStatus==x)">@x</option>}</select><select name="FiscalStatus"><option value="">Fiscal</option>@foreach(var x in Enum.GetValues<FiscalDocumentStatus>()){<option value="@x" selected="@(f.FiscalStatus==x)">@x</option>}</select><button class="commercial-button primary">Filtrar</button><a class="commercial-button" asp-action="Index">Limpar</a></form>
<div class="commercial-card"><div class="commercial-card-head"><h2>Vendas</h2><span>@Model.Page.TotalCount registro(s)</span></div><div class="commercial-table-scroll" tabindex="0"><table><thead><tr><th>Número</th><th>Cliente</th><th>Origem</th><th>Data</th><th class="num">Total</th><th>Pagamento</th><th>Comercial</th><th>Fiscal</th><th>Ações</th></tr></thead><tbody>@if(Model.Page.Items.Count==0){<tr><td colspan="9" class="commercial-empty"><strong>Nenhuma venda encontrada</strong><span>Converta um orçamento aprovado para iniciar.</span></td></tr>}else foreach(var x in Model.Page.Items){<tr><td><strong>VEN-@x.Number.ToString("000000")</strong></td><td>@x.CustomerName</td><td>@(x.QuoteId.HasValue?"Orçamento":"Direta")</td><td>@x.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="num">@x.Total.ToString("C")</td><td>@x.PaymentStatus</td><td><span class="commercial-status">@x.Status</span></td><td>@x.FiscalStatus</td><td><a asp-action="Details" asp-route-id="@x.Id">Abrir</a></td></tr>}</tbody></table></div><footer class="commercial-pagination"><span>Página @Model.Page.Page de @Model.TotalPages</span></footer></div></section>
