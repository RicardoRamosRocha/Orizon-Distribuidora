@model Orizon.Distribuidora.Web.Areas.Admin.Models.Commercial.SaleDetailsViewModel
@using Orizon.Distribuidora.Domain.Enums
@{ViewData["Title"]=$"Venda VEN-{Model.Sale.Number:000000}";var s=Model.Sale;}
@section Styles { <link rel="stylesheet" href="~/css/commercial-premium.css" asp-append-version="true" /> }
<section class="commercial-workspace"><header class="commercial-header"><div><h1>VEN-@s.Number.ToString("000000")</h1><p>@s.CustomerName · @s.Status</p></div><a class="commercial-button" asp-action="Receipt" asp-route-id="@s.Id" target="_blank">Comprovante</a></header>
@if(TempData["Success"] is string ok){<div class="commercial-alert success">@ok</div>}@if(TempData["Error"] is string err){<div class="commercial-alert error">@err</div>}<div class="non-fiscal-banner">DOCUMENTO NÃO FISCAL — NÃO SUBSTITUI NOTA FISCAL</div>
<div class="commercial-kpis"><div><span>Comercial</span><strong>@s.Status</strong></div><div><span>Pagamento</span><strong>@s.PaymentStatus</strong></div><div><span>Fiscal</span><strong>@s.FiscalStatus</strong><small>Módulo não habilitado</small></div><div><span>Total</span><strong>@s.Total.ToString("C")</strong></div></div>
<div class="commercial-card"><div class="commercial-table-scroll"><table><thead><tr><th>Código</th><th>Descrição</th><th>Tipo</th><th class="num">Qtd.</th><th class="num">Preço</th><th class="num">Total</th></tr></thead><tbody>@foreach(var x in s.Items){<tr><td>@x.ProductCode</td><td>@x.Description</td><td>@(x.ControlsStock&&x.IsOwnProduct?"Próprio/controlado":"Intermediado/sem baixa")</td><td class="num">@x.Quantity.ToString("N3")</td><td class="num">@x.UnitPrice.ToString("C")</td><td class="num">@x.Total.ToString("C")</td></tr>}</tbody></table></div></div>
<div class="commercial-actions action-bar">@if(s.Status==SaleStatus.Draft){<form asp-action="Confirm" asp-route-id="@s.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button primary">Confirmar e baixar estoque</button></form><form asp-action="Cancel" asp-route-id="@s.Id" method="post">@Html.AntiForgeryToken()<button class="commercial-button danger">Cancelar venda</button></form>}@if(s.QuoteId.HasValue){<a class="commercial-button" asp-controller="Quotes" asp-action="Details" asp-route-id="@s.QuoteId">Ver orçamento de origem</a>}</div></section>
