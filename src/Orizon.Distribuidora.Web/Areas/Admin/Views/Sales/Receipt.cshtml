@model Orizon.Distribuidora.Web.Areas.Admin.Models.Commercial.SaleDetailsViewModel
@{Layout=null;var s=Model.Sale;}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Comprovante VEN-@s.Number.ToString("000000")</title><link rel="stylesheet" href="~/css/commercial-print.css" asp-append-version="true"/></head><body><main class="print-document">
<header><div><h1>@(Model.Company?.TradeName??"Empresa")</h1><p>@Model.Company?.LegalName · CNPJ/CPF @Model.Company?.Document</p></div><div><strong>COMPROVANTE DE VENDA</strong><span>VEN-@s.Number.ToString("000000")</span></div></header><div class="warning">DOCUMENTO NÃO FISCAL — NÃO SUBSTITUI NOTA FISCAL</div>
<section class="meta"><p><strong>Cliente:</strong> @s.CustomerName</p><p><strong>Documento:</strong> @(s.CustomerDocument??"Não informado")</p><p><strong>Emissão:</strong> @s.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><p><strong>Situação:</strong> @s.Status · Pagamento @s.PaymentStatus</p></section><table><thead><tr><th>Código</th><th>Produto</th><th>Un.</th><th>Quantidade</th><th>Preço</th><th>Desconto</th><th>Total</th></tr></thead><tbody>@foreach(var x in s.Items){<tr><td>@x.ProductCode</td><td>@x.Description</td><td>@x.Unit</td><td>@x.Quantity.ToString("N3")</td><td>@x.UnitPrice.ToString("C")</td><td>@x.Discount.ToString("C")</td><td>@x.Total.ToString("C")</td></tr>}</tbody></table><section class="totals"><p>Subtotal <strong>@s.Subtotal.ToString("C")</strong></p><p>Frete <strong>@s.Freight.ToString("C")</strong></p><p class="grand">Total <strong>@s.Total.ToString("C")</strong></p></section><footer>Referência interna: @s.Id · Este comprovante não é NF-e nem NFC-e.</footer></main><button class="print-button" onclick="window.print()">Imprimir / Salvar como PDF</button></body></html>
