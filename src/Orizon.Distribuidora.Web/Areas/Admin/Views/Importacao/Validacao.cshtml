@model ImportacaoValidacaoViewModel
@using System.Text.Json
@using Orizon.Distribuidora.Application.Importacoes
@{
    ViewData["Title"] = "Validação da importação";
    ViewData["ApplicationName"] = "Distribuidora";

    string ColunaOriginal(string campo) =>
        Model.Mapeamentos.TryGetValue(campo, out var coluna) ? coluna : "Não mapeada";

}
@section Styles {
    <link rel='stylesheet' href='~/css/importacao-ux2.css' asp-append-version='true' />
    <link rel="stylesheet" href="~/css/importacao-premium.css" asp-append-version="true" />
}

<main class="import-workspace" data-import-validation>
    <header class="import-header">
        <div>
            <span class="import-eyebrow">Importação de produtos</span>
            <h1>Validação dos dados</h1>
            <p>Confira cada ocorrência antes de executar a importação.</p>
        </div>
        <span class="import-status @(Model.Resultado.PodeImportar ? "mapped" : "conflict")">
            @(Model.Resultado.PodeImportar ? "Pronta para avançar" : "Requer correções")
        </span>
    </header>

    <ol class="import-steps" aria-label="Progresso da importação">
        @foreach (var item in new[] { ("1", "Upload"), ("2", "Reconhecimento"), ("3", "Revisão"), ("4", "Validação"), ("5", "Execução"), ("6", "Resultado") })
        {
            <li class="@(item.Item1 == "4" ? "current" : int.Parse(item.Item1) < 4 ? "done" : "")">
                <span>@item.Item1</span>@item.Item2
            </li>
        }
    </ol>

    <section class="import-summary-grid import-validation-summary">
        @foreach (var card in new[]
        {
            ("Total de linhas", Model.Resultado.TotalLinhas),
            ("Válidas", Model.Resultado.QuantidadeValida),
            ("Novas", Model.Resultado.QuantidadeNovos),
            ("Atualizações", Model.Resultado.QuantidadeAtualizaveis),
            ("Com avisos", Model.Resultado.QuantidadeComAviso),
            ("Inválidas", Model.Resultado.QuantidadeComErro),
            ("Ignoradas", Model.Resultado.QuantidadeIgnoradas),
            ("Unidades preenchidas automaticamente", Model.Resultado.QuantidadeUnidadesPreenchidasAutomaticamente)
        })
        {
            <article><span>@card.Item1</span><strong>@card.Item2</strong></article>
        }
    </section>

    <partial name='_ProblemasValidacao' model='Model' />

    @if (Model.Resultado.QuantidadeValida == 0)
    {
        <section class="import-card import-empty-validation" role="alert">
            <div>
                <span class="import-eyebrow">Importação bloqueada</span>
                <h2>Nenhuma linha pode ser importada</h2>
                <p>As linhas bloqueadas não serão importadas. Corrija o mapeamento ou a planilha e valide novamente.</p>
            </div>
            <div class="import-empty-actions">
                @if (!string.IsNullOrWhiteSpace(Model.TokenArquivo))
                {
                    <a class="import-button primary"
                       href="@Url.Action("Mapeamento", new { id = Model.ImportacaoId, token = Model.TokenArquivo, aba = Model.AbaSelecionada })">
                        Corrigir mapeamento
                    </a>
                }
                else
                {
                    <a class="import-button primary" href="@Url.Action("Upload")">Enviar planilha corrigida</a>
                }
                <a class="import-button"
                   href="@Url.Action("ExportarExcel", new { id = Model.ImportacaoId, filtro = FiltroExportacaoImportacao.Erros })">
                    Baixar relatório de erros
                </a>
            </div>
        </section>
    }

    @{
        var correcoesSeguras = Model.Linhas
            .SelectMany(linha => linha.Erros.Concat(linha.Avisos))
            .Where(issue => issue.Codigo == "IMP_ESPACOS_EXTERNOS")
            .GroupBy(issue => issue.Codigo)
            .ToList();
    }
    @if (correcoesSeguras.Count > 0)
    {
        <section class="import-card">
            <h2>Aplicar correções a todas</h2>
            @foreach (var grupo in correcoesSeguras)
            {
                <label class="import-toggle">
                    <input type="checkbox" name="correcaoSegura" value="@grupo.Key">
                    <span>Remover espaços externos em @grupo.Count() ocorrência(s)</span>
                </label>
            }
            <p>As ocorrências continuarão visíveis para conferência.</p>
        </section>
    }

    <section class="import-card">
        <div class="import-card-heading">
            <div>
                <h2>Linhas da planilha</h2>
                <p>@Model.NomeArquivo · validado em @Model.Resultado.ValidadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        <form method="get" asp-action="ValidacaoResultado" asp-route-id="@Model.ImportacaoId" class="import-filters">
            <input type="hidden" name="id" value="@Model.ImportacaoId">
            <input type="hidden" name="token" value="@Model.TokenArquivo">
            @foreach (var filter in new[] { ("", "Todas"), ("validas", "Válidas"), ("novas", "Novas"), ("atualizacoes", "Atualizações"), ("avisos", "Avisos"), ("erros", "Erros"), ("duplicadas", "Duplicadas"), ("ignoradas", "Ignoradas") })
            {
                <button type="submit" name="filtro" value="@filter.Item1" class="import-filter @(Model.Filtro == filter.Item1 ? "active" : "")">@filter.Item2</button>
            }
            <input name="busca" value="@Model.Busca" placeholder="Código, descrição, linha ou erro">
            <button class="import-button" type="submit">Buscar</button>
        </form>

        <div class="import-table-scroll">
            <table class="import-table">
                <thead>
                    <tr><th>Linha</th><th>Código</th><th>Descrição</th><th>Operação</th><th>Status</th><th>Ocorrências</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Linhas)
                    {
                        <tr>
                            <td>@line.NumeroLinha</td>
                            <td>@(line.CodigoProduto ?? "—")</td>
                            <td>@(line.Descricao ?? "—")</td>
                            <td>@line.Operacao</td>
                            <td><span class="import-status @(line.PodeImportar ? "mapped" : "conflict")">@line.Status</span></td>
                            <td>@line.Erros.Count erro(s) · @line.Avisos.Count aviso(s)</td>
                            <td>
                                <button type="button" class="import-button" data-open-dialog="detail-@line.NumeroLinha">Detalhes</button>
                                <dialog class="import-dialog import-detail-dialog" id="detail-@line.NumeroLinha">
                                    <header>
                                        <div><h2>Linha @line.NumeroLinha</h2><p>@(line.CodigoProduto ?? "Sem código") · @(line.Descricao ?? "Sem descrição")</p></div>
                                        <button type="button" data-close-dialog aria-label="Fechar">×</button>
                                    </header>
                                    <div class="import-dialog-body">
                                        <h3>Erros e avisos</h3>
                                        @if (!line.Erros.Concat(line.Avisos).Any())
                                        {
                                            <p>Nenhuma ocorrência.</p>
                                        }
                                        else
                                        {
                                            <div class="import-issue-list">
                                                @foreach (var issue in line.Erros.Concat(line.Avisos))
                                                {
                                                    var problema = ProblemaValidacaoPresenter.Apresentar(issue, Model.Mapeamentos);
                                                    <article>
                                                        <dl>
                                                            <div><dt>Campo</dt><dd>@problema.CampoExibicao</dd></div>
                                                            <div><dt>Coluna original</dt><dd>@ColunaOriginal(issue.Campo)</dd></div>
                                                            <div><dt>Valor recebido</dt><dd>@(string.IsNullOrWhiteSpace(issue.ValorOriginal) ? "Vazio" : issue.ValorOriginal)</dd></div>
                                                            <div><dt>Por que aconteceu</dt><dd>@problema.Causa</dd></div>
                                                            <div><dt>Como resolver</dt><dd>@problema.Resolucao</dd></div>
                                                        </dl>
                                                    </article>
                                                }
                                            </div>
                                        }
                                        <h3>Dados originais</h3>
                                        <pre>@JsonSerializer.Serialize(line.DadosOriginais, new JsonSerializerOptions { WriteIndented = true })</pre>
                                    </div>
                                    <footer><button type="button" class="import-button" data-close-dialog>Fechar</button></footer>
                                </dialog>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="import-pagination">
            <a class="import-button @(Model.Pagina <= 1 ? "disabled" : "")"
               href="@Url.Action("ValidacaoResultado", new { id = Model.ImportacaoId, token = Model.TokenArquivo, filtro = Model.Filtro, busca = Model.Busca, pagina = Model.Pagina - 1 })">Anterior</a>
            <span>Página @Model.Pagina de @Model.TotalPaginas</span>
            <a class="import-button @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
               href="@Url.Action("ValidacaoResultado", new { id = Model.ImportacaoId, token = Model.TokenArquivo, filtro = Model.Filtro, busca = Model.Busca, pagina = Model.Pagina + 1 })">Próxima</a>
        </nav>
    </section>

    <div class="import-actions">
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.TokenArquivo))
            {
                <a class="import-button"
                   href="@Url.Action("Mapeamento", new { id = Model.ImportacaoId, token = Model.TokenArquivo, aba = Model.AbaSelecionada })">
                    Corrigir mapeamento
                </a>
            }
            <a class="import-button" href="@Url.Action("Historico")">Cancelar</a>
        </div>
        <button type="button" class="import-button primary" data-open-execution disabled="@(!Model.Resultado.PodeImportar || Model.Resultado.QuantidadeValida == 0)">
            Importar linhas válidas
        </button>
    </div>

    <dialog class="import-dialog" data-execution-dialog>
        <header><div><h2>Executar importação?</h2><p>Somente as linhas válidas serão processadas.</p></div></header>
        <div class="import-dialog-body">
            <p><strong>@Model.Resultado.QuantidadeNovos</strong> novos · <strong>@Model.Resultado.QuantidadeAtualizaveis</strong> atualizações · <strong>@(Model.Resultado.QuantidadeIgnoradas + Model.Resultado.QuantidadeComErro)</strong> ignoradas/bloqueadas</p>
        </div>
        <footer>
            <button type="button" class="import-button" data-close-dialog>Voltar</button>
            <form method="post" asp-action="Executar" data-execution-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ImportacaoId">
                <input type="hidden" name="token" value="@Model.TokenArquivo">
                <button class="import-button primary" type="submit">Confirmar execução</button>
            </form>
        </footer>
    </dialog>

    <div class="import-loading" data-loading hidden>
        <span></span><strong>Processando produtos…</strong><small>Os lotes confirmados serão preservados.</small>
    </div>
</main>

@section Scripts {
    <script src="~/js/importacao-fluxo.js" asp-append-version="true"></script>
}
