@model ImportacaoPreviewViewModel
@{ViewData["Title"]="Conferência da planilha";ViewData["ApplicationName"]="Distribuidora";}
@section Styles { <link rel="stylesheet" href="~/css/importacao-premium.css" asp-append-version="true" /> }
<main class="import-workspace"><header class="import-header"><div><span class="import-eyebrow">Orizon Data Recognition Engine</span><h1>Reconhecimento da planilha</h1><p>Confira aba, volume, cabeçalhos e amostra antes de revisar as sugestões inteligentes.</p></div><span class="import-stage-badge">Etapa 2 de 6 · Reconhecimento</span></header>
<ol class="import-steps">@foreach(var item in new[]{("1","Upload"),("2","Reconhecimento"),("3","Revisão"),("4","Validação"),("5","Execução"),("6","Resultado")}){<li class="@(item.Item1=="2"?"current":item.Item1=="1"?"done":"")"><span>@item.Item1</span>@item.Item2</li>}</ol>
<section class="import-summary-grid"><article><span>Arquivo</span><strong>@Model.NomeArquivo</strong><small>@Model.TamanhoFormatado</small></article><article><span>Aba selecionada</span><strong>@Model.AbaSelecionada</strong><small>@Model.Abas.Count aba(s) válida(s)</small></article><article><span>Linhas encontradas</span><strong>@Model.QuantidadeLinhas</strong><small>limite de 10.000</small></article><article><span>Colunas</span><strong>@Model.Cabecalhos.Count</strong><small>cabeçalhos únicos</small></article></section>
@if(Model.PossuiMultiplasAbas){<section class="import-card"><form method="get" asp-action="Preview" class="import-sheet-form"><input type="hidden" name="id" value="@Model.ImportacaoId"><input type="hidden" name="token" value="@Model.TokenArquivo"><label><span>Planilha para importação</span><select name="aba">@foreach(var sheet in Model.Abas){<option value="@sheet.Nome" selected="@(sheet.Nome==Model.AbaSelecionada)">@sheet.Nome · @sheet.QuantidadeLinhas linhas · @sheet.QuantidadeColunas colunas</option>}</select></label><button class="import-button" type="submit">Atualizar prévia</button></form></section>}
<section class="import-card"><div class="import-card-heading"><div><h2>Colunas reconhecidas</h2><p>Cabeçalhos duplicados são bloqueados antes desta etapa.</p></div></div><div class="import-header-list">@foreach(var header in Model.Cabecalhos){<span>@header</span>}</div><div class="import-table-scroll"><table class="import-table"><thead><tr><th>Linha</th>@foreach(var header in Model.Cabecalhos.Take(10)){<th>@header</th>}</tr></thead><tbody>@foreach(var row in Model.Amostra){<tr><td>@row.NumeroLinha</td>@foreach(var header in Model.Cabecalhos.Take(10)){<td>@(row.Valores.TryGetValue(header,out var value)?value:null)</td>}</tr>}</tbody></table></div></section>
<div class="import-actions"><form method="post" asp-action="Cancelar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ImportacaoId"><input type="hidden" name="token" value="@Model.TokenArquivo"><button class="import-button" type="submit">Cancelar importação</button></form><a class="import-button primary" href="@Url.Action("Mapeamento",new{id=Model.ImportacaoId,token=Model.TokenArquivo,aba=Model.AbaSelecionada})">Continuar para mapeamento</a></div></main>
