@model ImportacaoResultadoViewModel
@using Orizon.Distribuidora.Application.Importacoes
@{ViewData["Title"]="Resultado da Importação";ViewData["ApplicationName"]="Distribuidora";}
@section Styles { <link rel="stylesheet" href="~/css/importacao-premium.css" asp-append-version="true" /> }
<main class="import-workspace"><header class="import-header"><div><span class="import-eyebrow">Importação de produtos</span><h1>Resultado da importação</h1><p>@Model.Resultado.StatusFinal · @Model.Resultado.Duracao.TotalSeconds.ToString("0.0") segundos</p></div><div class="import-actions"><a class="import-button primary" href="@Url.Action("ExportarExcel",new{id=Model.Resultado.ImportacaoId})">Exportar Excel</a><a class="import-button" href="@Url.Action("ExportarCsv",new{id=Model.Resultado.ImportacaoId})">Exportar CSV</a></div></header>
<ol class="import-steps">@foreach(var item in new[]{("1","Upload"),("2","Conferência"),("3","Mapeamento"),("4","Validação"),("5","Execução"),("6","Resultado")}){<li class="@(item.Item1=="6"?"current":"done")"><span>@item.Item1</span>@item.Item2</li>}</ol>
@if(TempData["Error"] is string error){<div class="import-notice danger">@error</div>}
<section class="import-summary-grid import-result-summary">@foreach(var card in new[]{("Processados",Model.Resultado.TotalProcessado),("Inseridos",Model.Resultado.Inseridos),("Atualizados",Model.Resultado.Atualizados),("Sem alteração",Model.Resultado.SemAlteracao),("Ignorados",Model.Resultado.Ignorados),("Bloqueados",Model.Resultado.Bloqueados),("Falhas",Model.Resultado.Falhas)}){<article><span>@card.Item1</span><strong>@card.Item2</strong></article>}</section>
<section class="import-card"><div class="import-card-heading"><div><h2>Itens processados</h2><p>Consulta paginada diretamente no histórico persistido.</p></div></div><form method="get" asp-action="Resultado" class="import-filters"><input type="hidden" name="id" value="@Model.Resultado.ImportacaoId">@foreach(var filter in new[]{("","Todos"),("inseridos","Inseridos"),("atualizados","Atualizados"),("semAlteracao","Sem alteração"),("ignorados","Ignorados"),("bloqueados","Bloqueados"),("falhas","Falhas")}){<a class="import-filter @(Model.Filtro==filter.Item1?"active":"")" href="@Url.Action("Resultado",new{id=Model.Resultado.ImportacaoId,filtro=filter.Item1,busca=Model.Busca})">@filter.Item2</a>}<input name="busca" value="@Model.Busca" placeholder="Linha, código, descrição ou mensagem"><button class="import-button">Buscar</button></form><div class="import-table-scroll"><table class="import-table"><thead><tr><th>Linha</th><th>Código</th><th>Descrição</th><th>Operação</th><th>Resultado</th><th>Produto</th><th>Mensagem</th></tr></thead><tbody>@foreach(var item in Model.Itens){<tr><td>@item.Linha</td><td>@item.Codigo</td><td>@item.Descricao</td><td>@item.Operacao</td><td><span class="import-status @(item.Status is Orizon.Distribuidora.Domain.Enums.StatusLinhaImportacao.Falhou or Orizon.Distribuidora.Domain.Enums.StatusLinhaImportacao.Bloqueada?"conflict":"mapped")">@item.Status</span></td><td>@if(item.ProdutoId.HasValue){<a href="@Url.Action("Edit","Products",new{id=item.ProdutoId})">Abrir produto</a>}</td><td>@item.Mensagem</td></tr>}</tbody></table></div><nav class="import-pagination"><a class="import-button @(Model.Pagina<=1?"disabled":"")" href="@Url.Action("Resultado",new{id=Model.Resultado.ImportacaoId,filtro=Model.Filtro,busca=Model.Busca,pagina=Model.Pagina-1})">Anterior</a><span>Página @Model.Pagina de @Model.TotalPaginas</span><a class="import-button @(Model.Pagina>=Model.TotalPaginas?"disabled":"")" href="@Url.Action("Resultado",new{id=Model.Resultado.ImportacaoId,filtro=Model.Filtro,busca=Model.Busca,pagina=Model.Pagina+1})">Próxima</a></nav></section>
<div class="import-actions"><a class="import-button" href="@Url.Action("Historico")">Voltar ao histórico</a><a class="import-button primary" href="@Url.Action("Upload")">Nova importação</a></div></main>
