@model ImportacaoUploadViewModel
@{ViewData["Title"]="Nova Importação";ViewData["ApplicationName"]="Distribuidora";}
@section Styles { <link rel="stylesheet" href="~/css/importacao-premium.css" asp-append-version="true" /> }
<main class="import-workspace"><header class="import-header"><div><span class="import-eyebrow">Importação de produtos</span><h1>Nova importação</h1><p>Envie uma planilha OpenXML para iniciar a conferência segura.</p></div><span class="import-stage-badge">Etapa 1 de 6</span></header>
<ol class="import-steps">@foreach(var item in new[]{("1","Upload"),("2","Conferência"),("3","Mapeamento"),("4","Validação"),("5","Execução"),("6","Resultado")}){<li class="@(item.Item1=="1"?"current":"")"><span>@item.Item1</span>@item.Item2</li>}</ol>
@if(TempData["Error"] is string error){<orizon-alert variant="danger" title="Não foi possível continuar">@error</orizon-alert>}
<form asp-action="Upload" method="post" enctype="multipart/form-data" data-import-upload-form>@Html.AntiForgeryToken()<section class="import-card"><label class="import-dropzone" data-import-dropzone><span class="import-dropzone-icon"><orizon-icon name="upload-cloud" size="28" /></span><strong>Arraste a planilha para esta área</strong><span>ou selecione um arquivo @Model.FormatosAceitos de até @Model.TamanhoMaximoArquivoMB MB</span><button type="button" class="import-button" data-import-select>Selecionar arquivo</button><input class="import-file-input" type="file" name="arquivo" accept=".xlsx" data-import-file></label>
@if(!ViewData.ModelState.IsValid){<div class="import-validation-error"><orizon-alert variant="danger" title="Arquivo inválido">@Html.ValidationMessage("arquivo")</orizon-alert></div>}
<div class="import-selected-file" data-import-selected hidden><div><strong data-import-file-name></strong><small data-import-file-size></small></div><span>Assinatura ZIP/OpenXML será verificada</span></div></section>
<section class="import-card import-upload-rules"><div><strong>Até 10.000 linhas de dados</strong><span>O cabeçalho não entra no limite. Acima disso, divida o arquivo.</span></div><div><strong>Cadastros existentes</strong><span>Marca, categoria, unidade, fornecedor e parceiro não serão criados automaticamente.</span></div><div><strong>Processamento auditável</strong><span>Empresa, usuário, histórico, validação e execução permanecem isolados.</span></div></section>
<div class="import-actions"><a class="import-button" href="@Url.Action("Index")">Cancelar</a><button class="import-button primary" type="submit" data-upload-submit disabled>Continuar</button></div><div class="import-loading" data-loading hidden><span></span><strong>Lendo a planilha…</strong><small>Validando formato, abas, cabeçalhos e limite.</small></div></form></main>
@section Scripts { <script src="~/js/importacao-upload.js" asp-append-version="true"></script> }
