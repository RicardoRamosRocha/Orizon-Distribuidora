@model Orizon.Distribuidora.Web.Models.Home.HomeIndexViewModel
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Início";
    ViewData["ApplicationName"] = "Distribuidora";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-premium.css" asp-append-version="true" />
}

<div class="home-premium">
    <header class="home-hero">
        <div class="home-hero__copy">
            <span class="home-eyebrow">ORIZON DISTRIBUIDORA</span>
            <h1>@Model.Greeting</h1>
            <p>Uma central única para organizar produtos, estoque, preços e o fluxo comercial da sua distribuidora.</p>
            <div class="home-hero__actions">
                <a class="home-button home-button--primary"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <orizon-icon name="arrow-right" size="18"></orizon-icon>
                    Acessar área administrativa
                </a>
                @if (!Model.IsAuthenticated)
                {
                    <a class="home-button home-button--secondary"
                       asp-area="" asp-controller="Account" asp-action="Login">
                        Entrar com sua conta
                    </a>
                }
            </div>
        </div>
        <aside class="home-start" aria-label="Orientação inicial">
            <span class="home-start__icon" aria-hidden="true"><orizon-icon name="dashboard" size="22"></orizon-icon></span>
            <div>
                <strong>Comece pela Área Administrativa</strong>
                <p>Entre no ambiente de trabalho para consultar a operação e acessar os módulos permitidos ao seu perfil.</p>
            </div>
        </aside>
    </header>

    @if (Model.CanAccessAdministration)
    {
        <section class="home-section" aria-labelledby="quick-access-title">
            <div class="home-section__heading">
                <div>
                    <span class="home-eyebrow">ACESSO RÁPIDO</span>
                    <h2 id="quick-access-title">Retome seu trabalho</h2>
                </div>
                <span>Atalhos para áreas autorizadas</span>
            </div>
            <div class="home-shortcuts">
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <span><orizon-icon name="package" size="21"></orizon-icon></span>
                    <strong>Produtos</strong><small>Catálogo e cadastros</small>
                </a>
                <a asp-area="Admin" asp-controller="Quotes" asp-action="Index">
                    <span aria-hidden="true"><orizon-icon name="clipboard" size="21"></orizon-icon></span>
                    <strong>Orçamentos</strong><small>Propostas comerciais</small>
                </a>
                <a asp-area="Admin" asp-controller="Stock" asp-action="Index">
                    <span><orizon-icon name="warehouse" size="21"></orizon-icon></span>
                    <strong>Estoque</strong><small>Saldos e movimentações</small>
                </a>
                <a asp-area="Admin" asp-controller="Importacao" asp-action="Index">
                    <span><orizon-icon name="upload" size="21"></orizon-icon></span>
                    <strong>Importação</strong><small>Entrada assistida de dados</small>
                </a>
                <button type="button" data-pdf-summer-open>
                    <span><orizon-icon name="calculator" size="21"></orizon-icon></span>
                    <strong>Calculadora de PDF</strong><small>Conferência de documentos</small>
                </button>
            </div>
        </section>
    }

    <section class="home-section" aria-labelledby="platform-title">
        <div class="home-section__heading">
            <div>
                <span class="home-eyebrow">PLATAFORMA</span>
                <h2 id="platform-title">A operação, conectada de ponta a ponta</h2>
            </div>
        </div>
        <div class="home-modules">
            <article><span>01</span><div><strong>Produtos e cadastros</strong><p>Organize o catálogo e as informações que sustentam a operação.</p></div></article>
            <article><span>02</span><div><strong>Estoque</strong><p>Acompanhe saldos, entradas, saídas e rastreabilidade.</p></div></article>
            <article><span>03</span><div><strong>Preços</strong><p>Mantenha custos e valores de venda consistentes.</p></div></article>
            <article><span>04</span><div><strong>Orçamentos e vendas</strong><p>Conduza o fluxo comercial não fiscal com clareza.</p></div></article>
            <article><span>05</span><div><strong>Administração</strong><p>Gerencie empresa, acessos, preferências e auditoria.</p></div></article>
        </div>
    </section>
</div>
